# Dashboard -> API Keys. Never prefix these with NEXT_PUBLIC_.
CRED_API_KEY=sk_live_your_api_key
# Dashboard -> Credit Types -> Credit Type ID
CRED_CREDIT_TYPE_ID=your_credit_type_id
# Optional: enables the "Buy credits" button
CRED_PRICING_TIER_ID=your_pricing_tier_id
# Base URL used for Stripe success and cancel redirects
APP_URL=http://localhost:3000
